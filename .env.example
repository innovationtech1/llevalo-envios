# Copia este archivo como .env.local (o agrega estas variables en Vercel → Settings → Environment Variables).

# Base de datos Postgres (Neon). Sin esta variable la app corre en "modo demo":
# los datos viven en memoria y se borran al reiniciar el servidor.
DATABASE_URL=

# Clave de Google Maps (Geocoding API + Distance Matrix API). Opcional:
# sin ella se usa OpenStreetMap, gratis pero con límites de uso.
GOOGLE_MAPS_API_KEY=

# PIN de 4 a 8 dígitos para entrar al panel de administrador.
# Sin PIN, el panel queda abierto (solo para pruebas).
ADMIN_PIN=

# Correo de contacto que OpenStreetMap pide en cada búsqueda de direcciones.
CONTACT_EMAIL=
