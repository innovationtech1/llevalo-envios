# Agrega estas variables en Vercel → Settings → Environment Variables (y vuelve a publicar).
# Ninguna es obligatoria para probar: lo que falte funciona en "modo prueba".

# Base de datos Postgres (Neon). Vercel la agrega sola al conectar Neon en Storage.
DATABASE_URL=

# Tu(s) teléfono(s) de administrador, separados por comas. Ej: 2109900532
ADMIN_PHONES=
# Solo en modo prueba (sin Twilio): el código para entrar como administrador.
ADMIN_PIN=

# Google Maps: Places API (New), Routes API y Geocoding API activadas en la misma clave.
GOOGLE_MAPS_API_KEY=

# Stripe (cobro con tarjeta). Usa primero las claves de prueba (sk_test_...).
STRIPE_SECRET_KEY=
# Firma del webhook https://TU-DOMINIO/api/stripe/webhook (eventos checkout.session.*)
STRIPE_WEBHOOK_SECRET=

# Twilio Verify (códigos por SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Opcional: secreto para firmar sesiones (si falta, se deriva de DATABASE_URL)
SESSION_SECRET=
# Correo de contacto para OpenStreetMap (solo si no hay Google Maps)
CONTACT_EMAIL=
